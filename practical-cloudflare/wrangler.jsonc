{
  "name": "srs-practical-register",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/photo", "/setup"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "srs-practical-register", "database_id": "PUT-YOUR-D1-DATABASE-ID-HERE" }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "srs-practical-photos" }
  ]
}
